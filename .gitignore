# ===========================
# FASHR V2 — Combined .gitignore
# Node.js + Python + IDE + OS
# ===========================

# ---------- Environment ----------
.env
.env.local
.env.*.local

# ---------- Python ----------
__pycache__/
*.py[cod]
*$py.class
*.egg-info/
*.egg
dist/
build/
.venv/
venv/
.conda/
*.whl

# ---------- Node.js ----------
node_modules/
.next/
out/
.vercel/
.turbo/
npm-debug.log*
yarn-debug.log*
yarn-error.log*
pnpm-debug.log*

# ---------- IDE ----------
.vscode/
.idea/
*.swp
*.swo
*~

# ---------- OS ----------
.DS_Store
Thumbs.db
Desktop.ini

# ---------- Testing / Coverage ----------
coverage/
.coverage
htmlcov/
.pytest_cache/
.nyc_output/

# ---------- Misc ----------
*.log
*.bak
*.tmp
